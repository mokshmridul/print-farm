# print-farm — environment template for docker-compose.yml.
# Copy to `.env`, fill in real values. `.env` is git-ignored; never commit it.
#
# The container generates and keeps its own database, Redis and session
# secrets in the data volume, so there are no passwords to invent here. Every
# value below is optional except APP_ORIGIN.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public origin of the app (used for CSRF origin checks, links in PDFs/emails).
# Must be https:// unless it is localhost or a private-network address.
APP_ORIGIN=https://print.rish.pw

# Image to run. Every commit on main is published as :sha-<7 hex> and :latest.
#PRINT_IMAGE=ghcr.io/mokshmridul/print-farm:latest

# Host address and port the container's :8080 is published on. Defaults to
# 127.0.0.1:8080 (loopback only — unreachable from other machines). For
# production set PROXY_BIND to the host's Tailscale IP so the VPS nginx can
# reach it over the tailnet. Never set it to 0.0.0.0 on a public server.
#PROXY_BIND=100.x.y.z
#PROXY_PORT=8080

# The one forwarder (your reverse proxy / cloudflared) allowed to tell the shop
# the visitor's real address, as the container sees it: its tailnet IP, NAT
# address, or — for a proxy on this same host reaching a loopback-published
# port — the Docker network's gateway. One IPv4 host (optionally /32) or one
# unbracketed IPv6 host (optionally /128); anything broader is rejected at
# startup. Empty: no forwarder is trusted and every peer is served, each as
# itself. Set: every other transport peer gets 403.
TRUSTED_PROXY_CIDR=
# The header that forwarder puts the visitor's address in: X-Real-IP (nginx and
# most proxies) or CF-Connecting-IP (cloudflared).
#REAL_IP_HEADER=X-Real-IP
# 1: with a forwarder set, also serve every other peer, each as itself — e.g.
# devices on your network opening http://<PROXY_BIND>:<PROXY_PORT> beside the
# tunnel. Their visits are plain HTTP, so cookies for them aren't Secure.
#DIRECT_ACCESS=0

# ---------------------------------------------------------------------------
# Admin login
# ---------------------------------------------------------------------------
# Leave both empty and a password is generated on first boot and printed once
# in `docker compose logs` (and kept, root-only, in /data/secrets). Change it
# any time with:
#   docker compose exec print-farm print-farm admin-password
#
# ADMIN_PASSWORD is hashed on first boot only and never stored in plain text.
#ADMIN_PASSWORD=
# Or pin a bcrypt hash (cost 12+). It then takes precedence over the password
# kept in the volume. Hashes contain '$', which Compose interpolates: wrap the
# value in single quotes, e.g. ADMIN_PASSWORD_HASH='$2a$12$abc…'
#   docker run --rm -i --entrypoint node ghcr.io/mokshmridul/print-farm /opt/tools/hash-password.mjs
ADMIN_PASSWORD_HASH=

# Normally generated in the volume. Pin it only when moving an existing install
# here, so admin settings sealed with the old secret stay readable.
#SESSION_SECRET=

# ---------------------------------------------------------------------------
# Printer
# ---------------------------------------------------------------------------
# Unset: the hand-tuned Bambu Lab A1 profiles. Otherwise an exact OrcaSlicer
# machine preset (docker/selfhost/printers.tsv, third column); the container
# generates its profiles on boot.
#PRINTER_MACHINE=Prusa MK4 0.4 nozzle
#PRINTER_MULTI_MATERIAL=0
# 1 = upload your own OrcaSlicer presets in admin → Slicer profiles.
#PRINTER_ADVANCED=0
#PRINTER_DISPLAY_NAME=

# ---------------------------------------------------------------------------
# Business configuration
# ---------------------------------------------------------------------------
# WhatsApp number for quotation handoff, international format WITHOUT '+'
# (ISD code + number), e.g. 919876543210 for an Indian number.
WHATSAPP_NUMBER=919876543210

# Unused — the contact page email, phone and address live in admin → Site.
CONTACT_EMAIL=you@example.com
# Optional: full Google Maps embed URL (https://www.google.com/maps/embed?pb=...).
# Leave empty to hide the map.
GOOGLE_MAPS_EMBED_URL=

# ---------------------------------------------------------------------------
# Contact form → email (Resend). The /api/contact route posts messages here.
# Without RESEND_API_KEY + MAIL_TO the form returns a "not configured" error.
# ---------------------------------------------------------------------------
# Resend API key: https://resend.com/api-keys  (can reuse the rish.pw account).
RESEND_API_KEY=
# Where contact-form messages are delivered.
MAIL_TO=
# From address — must be a verified Resend domain sender.
CONTACT_FROM=print.rish.pw <contact@rish.pw>

# ---------------------------------------------------------------------------
# Telegram new-order notifications and PII-free operator alerts (optional).
# If either value is empty, checkout still works and no Telegram message is sent.
# Create a bot with @BotFather, send it a message/add it to a private chat, then
# use the chat id as TELEGRAM_CHAT_ID.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Telegram forum topic/thread id for group topics.
#TELEGRAM_MESSAGE_THREAD_ID=

# ---------------------------------------------------------------------------
# Shiprocket rate calculator (shipping estimates on the quote page).
# The /api/shipping route logs in and calls courier serviceability.
# Admin → Shipping replaces all three once it has been saved there. With
# neither, the quote page has no shipping estimator.
#
# IMPORTANT: these must be *API-user* credentials, NOT your normal dashboard
# login. Create them in Shiprocket → Settings → API → Configure → "Create an
# API user". Using the dashboard login makes /auth/login return
# 403 "Access forbidden" (API access isn't enabled on that user).
# ---------------------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Origin/pickup pincode (the workshop). Set this to your own; defaults to
# 781001 (Guwahati GPO).
SHIPROCKET_PICKUP_PINCODE=781001

# ---------------------------------------------------------------------------
# Files & retention
# ---------------------------------------------------------------------------
# Per-file upload cap, in megabytes.
MAX_UPLOAD_MB=300
# Persistent files held by one active anonymous quote session.
MAX_SESSION_UPLOAD_MB=900
# Per-IP upload bytes accepted in one 10-minute window.
UPLOAD_WINDOW_MB=900
# Per-IP model bytes downloaded in one 10-minute window.
DOWNLOAD_WINDOW_MB=1200
# Stop accepting uploads before the data filesystem is completely full.
STORAGE_RESERVE_MB=2048
# Host/LXC bind paths used only with docker-compose.vault.yml.
#PRINT_DB_DIR=/srv/print-data/postgres
#PRINT_UPLOAD_DIR=/srv/print-data/files/uploads
#PRINT_PDF_DIR=/srv/print-data/files/pdfs
#PRINT_REDIS_DIR=/srv/print-data/redis
# Max models per quote session.
MAX_MODELS_PER_SESSION=20
# Hours to keep uploads that were never attached to a submitted quotation.
UPLOAD_RETENTION_HOURS=48
# Days to keep model files after every referencing quotation is terminal and
# older than this window.
FILE_RETENTION_DAYS=30
# Deletion threshold in days after the last update to a completed, delivered,
# or cancelled quotation (maximum 90; a larger value is capped). The sweep
# deletes quotation rows (including customer contact and address fields), PDFs,
# and models that become unreferenced; non-terminal quotations never age out.
QUOTATION_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Parallel OrcaSlicer processes. 2 is right for a 6-core host; raise with care.
WORKER_CONCURRENCY=2
# Hard kill for a single slice, in seconds.
SLICE_TIMEOUT_SECONDS=180
# Thumbnail render resolution (square PNG, px).
THUMB_SIZE=512
LOG_LEVEL=info
# CI/development HTTP-flow harness only. Exact `true` requires NODE_ENV to be
# explicitly `development` or `test`; worker startup refuses it otherwise.
# Synthetic results can poison a persistent slice cache, so use only disposable
# integration PostgreSQL/Redis stores. This flag is never forwarded to the image.
#STUB_SLICER=false
# Where everything durable lives (database, uploads, PDFs, generated secrets):
# a host directory, as an absolute path. Unset: the named Docker volume
# print_data. The self-host installer sets <install folder>/data.
#PRINT_DATA_DIR=/opt/print-shop/data
# Your OrcaSlicer exports to slice with (printer/, process/, filament/), read
# when the container starts. Default: ./profiles beside this file.
#PRINT_PROFILES_DIR=/opt/print-shop/profiles
# Memory ceiling for the whole container (slicer, parser, database, web).
#PRINT_MEMORY=12g
# Size of the in-memory /tmp the slicer stages models in (counts toward it).
#PRINT_TMP_SIZE=3g
