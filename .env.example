# print-farm — optional overrides for docker-compose.yml.
#
# You don't need this file: everything is set in the browser on first run
# (admin → Settings afterwards) and kept in data/config/settings.json and the
# database. Copy it to `.env` only to pin something from outside; a value set
# here always wins over the browser, which then shows it locked.

# --- Where it runs ----------------------------------------------------------
#PRINT_IMAGE=ghcr.io/mokshmridul/print-farm:latest
#PRINT_PORT=8080                      # or 127.0.0.1:8080 to publish on loopback only
#PRINT_DATA_DIR=./data
#PRINT_PROFILES_DIR=./profiles
#PRINT_MEMORY=12g

# --- Server settings (admin → Settings → Server) ------------------------------
# Public web address, https:// unless it's a private-network address.
#APP_ORIGIN=https://print.example.com
# The reverse proxy allowed to tell the shop the visitor's real address: one
# IPv4/IPv6 host as the container sees it, or "host" for a proxy on this same
# computer (the container's gateway). Empty: trust none, serve every peer.
#TRUSTED_PROXY_CIDR=
#REAL_IP_HEADER=X-Real-IP             # or CF-Connecting-IP (cloudflared)
#DIRECT_ACCESS=0                      # 1: also serve LAN devices beside the proxy
# The printer: an exact OrcaSlicer machine preset (the setup tour lists them).
# Empty: you upload your own OrcaSlicer printer preset instead.
#PRINTER_MACHINE=Prusa MK4 0.4 nozzle
#PRINTER_MULTI_MATERIAL=0
#PRINTER_DISPLAY_NAME=
#ADVANCED_PROFILES=0                  # 1: take your own presets for every slot

# --- Admin password -------------------------------------------------------------
# Normally created in the browser on first run (with the setup code from the
# log) and changed with `docker exec -it print-farm print-farm admin-password`.
# Setting one here overrides it. A bcrypt hash contains '$': single-quote it.
#ADMIN_PASSWORD=
#ADMIN_PASSWORD_HASH=
# Generated in the data folder; pin it only when moving an install here.
#SESSION_SECRET=

# --- Integrations (also in admin → Settings) ----------------------------------
#WHATSAPP_NUMBER=                     # international, no '+', e.g. 919876543210
#GOOGLE_MAPS_EMBED_URL=
#RESEND_API_KEY=
#MAIL_TO=
#CONTACT_FROM=
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#TELEGRAM_MESSAGE_THREAD_ID=
#SHIPROCKET_EMAIL=                    # API-user credentials, not the dashboard login
#SHIPROCKET_PASSWORD=
#SHIPROCKET_PICKUP_PINCODE=

# --- Limits and retention ------------------------------------------------------
#MAX_UPLOAD_MB=300
#MAX_SESSION_UPLOAD_MB=900
#UPLOAD_WINDOW_MB=900
#DOWNLOAD_WINDOW_MB=1200
#STORAGE_RESERVE_MB=2048
#MAX_MODELS_PER_SESSION=20
#UPLOAD_RETENTION_HOURS=48
#FILE_RETENTION_DAYS=30
#QUOTATION_RETENTION_DAYS=90
#WORKER_CONCURRENCY=1
#SLICE_TIMEOUT_SECONDS=600
#LOG_LEVEL=info
