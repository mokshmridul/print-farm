{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "allowJs": true,
    // Ambient @types to auto-include. TypeScript 6 still enumerates all of
    // node_modules/@types by default, so this changes nothing today (verified:
    // identical --listFiles output either way) — it is here because 7 defaults
    // it to [], and process/Buffer/NodeJS are used across the app. Everything
    // else — react, react-dom, three, busboy, and vitest's chai/deep-eql —
    // arrives through imports, which this option does not govern.
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // test-integration reaches into apps/worker/src. Next 16 type-checks the
  // app's tsconfig during `next build`, so including it makes the web build
  // depend on the worker sources being in the build context — the old web-only
  // image context had none, and failed with TS2307 while `pnpm build` in the
  // full monorepo still passed: green CI, broken deploy.
  // They keep full type coverage via tsconfig.test-integration.json.
  "exclude": ["node_modules", "test-integration"]
}
